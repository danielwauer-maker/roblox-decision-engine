APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://rde:rde_dev@postgres:5432/roblox_decision_engine
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
PLAYDIRECTIVE_COMMERCIAL_MODE=pilot
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Roblox Open Cloud analytics (read-only scope: universe.analytics:read)
# Legacy single-environment validation only. R13 real studios configure one encrypted connection per tenant.
ROBLOX_UNIVERSE_ID=
ROBLOX_API_KEY=
ROBLOX_ANALYTICS_BASE_URL=https://apis.roblox.com/analytics-query-api

# Optional AI Product Analyst provider. Without a key, the API uses the deterministic grounded fallback.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna

# Tenant pilot. Generate strong random values in production; never commit real values.
PILOT_ADMIN_TOKEN=
PILOT_CREDENTIAL_KEY=
PILOT_SESSION_HOURS=840
PILOT_INVITE_HOURS=72
PILOT_LOGIN_LINK_MINUTES=20

# Transactional email / lifecycle (Resend)
RESEND_API_KEY=
EMAIL_FROM=PlayDirective <pilot@playdirective.com>
OPERATOR_EMAIL=
LIFECYCLE_STALE_DAYS=7

# Stripe subscriptions. Configure TEST-mode values first. Do not paste secrets into source control.
# Use Stripe Sandbox keys while STRIPE_MODE=test. Never place a secret key in browser variables.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_MANAGED_PAYMENTS_ENABLED=false
STRIPE_TEST_BILLING_MODE=false
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE_PERSONAL=
STRIPE_PRICE_INDIE_BUSINESS=
STRIPE_PRICE_GROWTH_PERSONAL=
STRIPE_PRICE_GROWTH_BUSINESS=
STRIPE_PRICE_STUDIO_PERSONAL=
STRIPE_PRICE_STUDIO_BUSINESS=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Private operator console. These values exist only on the server.
ADMIN_DASHBOARD_USERNAME=operator
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
