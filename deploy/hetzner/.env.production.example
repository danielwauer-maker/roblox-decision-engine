# Paths
RDE_DATA_DIR=/mnt/HC_Volume_106874499/rde

# PostgreSQL (local Docker database on Hetzner)
POSTGRES_DB=roblox_decision_engine
POSTGRES_USER=rde
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# Public URLs
PUBLIC_APP_URL=https://playdirective.com
CORS_ORIGINS=https://playdirective.com
# Browser code should normally use same-origin Next.js API routes. Keep the direct API bound to localhost only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8091

# Tenant/admin security
PILOT_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM
PILOT_CREDENTIAL_KEY=CHANGE_ME_FERNET_KEY
PILOT_SESSION_HOURS=840
PILOT_INVITE_HOURS=72
PILOT_LOGIN_LINK_MINUTES=20
ADMIN_DASHBOARD_USERNAME=operator
ADMIN_DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM

# Legal notice (production values stay private in .env.production)
LEGAL_OPERATOR_NAME=
LEGAL_STREET_ADDRESS=
LEGAL_POSTAL_CITY=
LEGAL_COUNTRY=Germany
LEGAL_EMAIL=
LEGAL_ADDITIONAL_DETAILS=

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna

# Roblox Open Cloud
ROBLOX_ANALYTICS_BASE_URL=https://apis.roblox.com/analytics-query-api
WRITE_RATE_LIMIT_PER_MINUTE=60

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=PlayDirective <pilot@playdirective.com>
OPERATOR_EMAIL=
LIFECYCLE_STALE_DAYS=7

# Stripe subscriptions - use TEST MODE until R16 acceptance is complete
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_STUDIO=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
